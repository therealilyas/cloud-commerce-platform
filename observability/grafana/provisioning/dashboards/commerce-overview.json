{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Services Up",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "sum(up{job=\"commerce-services\"})", "legendFormat": "healthy"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests / second",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [{"expr": "sum by (application) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{application}}"}]
    },
    {
      "type": "timeseries",
      "title": "p95 HTTP latency",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{application}}"}]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{application}}"}]
    }
  ],
  "schemaVersion": 39,
  "tags": ["java", "microservices", "portfolio"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "title": "Cloud Commerce Overview",
